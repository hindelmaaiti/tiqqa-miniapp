.login-page {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #B38F7F; /* Standard tiqqa background */
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}

.login-header {
  padding: 100rpx 48rpx 80rpx;
  text-align: center;
}

.login-logo {
  width: 220rpx;
  display: block;
  margin: 0 auto;
}

.login-card {
  background: #FFFFFF;
  border-radius: 60rpx 60rpx 0 0;
  padding: 60rpx 50rpx 80rpx;
  box-shadow: 0 -15rpx 40rpx rgba(0, 0, 0, 0.08);
  flex: 1;
  display: flex;
  flex-direction: column;
}

.login-title-wrap {
  margin-bottom: 60rpx;
}

.login-title {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 12rpx;
}

.login-subtitle {
  font-size: 28rpx;
  color: #888888;
  font-weight: 400;
}

.login-field {
  margin-bottom: 40rpx;
}

.login-label {
  display: block;
  font-size: 26rpx;
  color: #555555;
  margin-bottom: 16rpx;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.login-input-container {
  position: relative;
  width: 100%;
}

.login-input {
  width: 100%;
  height: 100rpx;
  padding: 0 30rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  color: #333333;
  background: #F8F9FA;
  border: 2rpx solid #EEEEEE;
  border-radius: 20rpx;
  transition: all 0.3s ease;
}

.login-placeholder {
  color: #BBBBBB;
}

.login-eye {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  padding: 20rpx;
  z-index: 5;
}

.login-eye-icon {
  font-size: 24rpx;
  color: #B38F7F;
  font-weight: 600;
}

.login-forgot-wrap {
  text-align: right;
  margin-bottom: 60rpx;
}

.login-forgot {
  font-size: 26rpx;
  color: #B38F7F;
  font-weight: 500;
}

.login-actions {
  margin-top: auto;
}

.login-btn {
  width: 100%;
  height: 110rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 55rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 10rpx 20rpx rgba(179, 143, 127, 0.2);
}

.login-btn--primary {
  background: #B38F7F;
  color: #FFFFFF;
}

.login-signup-wrap {
  text-align: center;
  margin-bottom: 20rpx;
}

.login-no-account {
  font-size: 28rpx;
  color: #888888;
}

.login-signup-link {
  font-size: 28rpx;
  color: #B38F7F;
  font-weight: 700;
}

.home-indicator {
  position: absolute;
  bottom: 12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 134rpx;
  height: 10rpx;
  background: rgba(0, 0, 0, 0.1);
  border-radius: 5rpx;
}
