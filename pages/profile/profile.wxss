.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #ffffff; /* Change to white to remove the bottom frame */
  overflow: hidden;
}

.header-bg {
  width: 100%;
  padding-bottom: 40rpx;
  background-color: #B38F7F; /* Apply brand color only to header */
}

.header-content {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  height: 88rpx;
  padding: 0 40rpx;
}

.back-btn {
  position: absolute;
  left: 30rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.08);
  border-radius: 50%;
}

.back-arrow {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
}

.logo {
  width: 160rpx;
  height: 50rpx;
}

.content-card {
  flex: 1;
  background-color: #ffffff;
  border-radius: 60rpx 60rpx 0 0;
  padding: 40rpx 40rpx 0;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -10rpx 30rpx rgba(0, 0, 0, 0.05);
  overflow: hidden; /* Ensure scroll stays inside the card */
}

.tabs-container {
  display: flex;
  background: #ffffff;
  border: 1rpx solid #E0E0E0;
  border-radius: 50rpx;
  overflow: hidden;
  margin-bottom: 50rpx;
  height: 84rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
}

.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #B38F7F;
  gap: 16rpx;
  transition: all 0.2s ease;
}

.tab.active {
  background-color: #B38F7F;
  color: #ffffff;
}

.tab-icon-wrap {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-icon-img {
  width: 28rpx;
  height: 28rpx;
  filter: brightness(0) invert(1);
}

.tab-icon-text {
  font-size: 28rpx;
}

.tab-label {
  font-weight: 500;
}

.profile-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.avatar-circle {
  width: 140rpx;
  height: 140rpx;
  background-color: #B38F7F;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  box-shadow: 0 8rpx 20rpx rgba(179, 143, 127, 0.2);
}

.avatar-circle text {
  color: #ffffff;
  font-size: 64rpx;
  font-weight: 500;
}

.user-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #000000;
}

.form-container {
  flex: 1;
  overflow-y: auto;
  padding-bottom: 40rpx;
}

.input-group {
  margin-bottom: 30rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #000000;
  margin-bottom: 12rpx;
}

.input {
  width: 100%;
  height: 88rpx;
  background-color: #FAFAFA;
  border: 1rpx solid #F0F0F0;
  border-radius: 20rpx;
  padding: 0 32rpx;
  font-size: 26rpx;
  color: #333333;
  box-sizing: border-box;
}

.input::-webkit-input-placeholder {
  color: #B0B0B0;
}

.phone-input-wrap {
  display: flex;
  gap: 20rpx;
}

.operator-selector {
  width: 140rpx;
  height: 88rpx;
  background-color: #FAFAFA;
  border: 1rpx solid #F0F0F0;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-sizing: border-box;
}

.operator-logo {
  width: 80rpx;
  height: 40rpx;
}

.dropdown-arrow {
  font-size: 20rpx;
  color: #B38F7F;
}

.select-input {
  width: 100%;
  height: 90rpx;
  border: 2rpx solid #EEEEEE;
  border-radius: 16rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.select-value {
  font-size: 28rpx;
  color: #333333;
}

.select-value.placeholder {
  color: #999;
}

.separator-dots {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin: 40rpx 0;
}

.dot {
  width: 8rpx;
  height: 8rpx;
  background-color: #E0E0E0;
  border-radius: 50%;
}

.emergency-section {
  background-color: #F9F9F9;
  border-radius: 30rpx;
  padding: 30rpx;
  margin-top: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #000;
  margin-bottom: 30rpx;
  display: block;
}

.emergency-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.emergency-card {
  background-color: #ffffff;
  border: 2rpx solid #E3EAF2;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
}

.contact-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.contact-avatar {
  width: 80rpx;
  height: 80rpx;
  background-color: #F0F2F5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.contact-icon-img {
  width: 40rpx;
  height: 40rpx;
}

.contact-details {
  display: flex;
  flex-direction: column;
}

.contact-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #000;
}

.contact-phone {
  font-size: 24rpx;
  color: #666;
}

.contact-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.action-divider {
  width: 2rpx;
  height: 40rpx;
  background-color: #E0E0E0;
}

.delete-btn-img {
  width: 32rpx;
  height: 32rpx;
}

.phone-input {
  flex: 1;
}

.footer-btn-wrap {
  padding: 30rpx 0;
  flex-shrink: 0;
  background-color: #fff;
}

.btn-valider {
  width: 100% !important;
  height: 100rpx;
  background-color: #B38F7F !important;
  color: #ffffff !important;
  border-radius: 50rpx !important;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  border: none !important;
  box-shadow: 0 10rpx 20rpx rgba(179, 143, 127, 0.2);
}

/* Member Info Modal Styles */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  z-index: 1000;
  backdrop-filter: blur(4px);
}

.member-modal {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  border-radius: 60rpx 60rpx 0 0;
  z-index: 1001;
  padding: 40rpx;
  animation: slideUp 0.3s ease-out;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.modal-header {
  display: flex;
  justify-content: flex-start;
  margin-bottom: 20rpx;
}

.close-btn {
  font-size: 50rpx;
  color: #999;
  line-height: 1;
  padding: 10rpx;
}

.modal-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #000;
  margin-bottom: 50rpx;
  text-align: left;
}

.modal-footer {
  margin-top: 60rpx;
}

/* Ensure modal looks good on larger screens */
@media screen and (min-height: 800px) {
  .member-modal {
    max-height: 85vh;
  }
}
