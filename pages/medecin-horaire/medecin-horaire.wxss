page {
  height: 100%;
  background: #1d1f23;
}

.page-horaire {
  height: 100%;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 16rpx 0 calc(20rpx + env(safe-area-inset-bottom));
  background: #1d1f23;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow-x: hidden;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

/* Pas de scroll sur la carte : sinon le scroll-view des créneaux ne reçoit pas le geste */
.mobile-card {
  margin: 0 auto;
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #ffffff;
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.22);
}

.mobile-card--figma {
  width: 750rpx;
  max-width: 100%;
  box-sizing: border-box;
  border-radius: 57.6923076923rpx;
  min-height: 1619.2307692308rpx;
  overflow-x: hidden;
  position: relative;
}

/* 312 px Figma : hauteur jusqu’au bloc vert créneaux */
.horaire-above-slots {
  flex-shrink: 0;
  /* Header + hero : min-height pour ne pas couper le header après ajout de la barre statut */
  min-height: 540rpx;
  height: auto;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: visible;
}

/* En-tête + statut : même principe que medecin-domicile (capture 2) */
.horaire-header-wrap {
  flex-shrink: 0;
  background: #ffffff;
  /* Figma: top de la zone menthe a 101px => header blanc 101px */
  min-height: 194.2307692308rpx;
  height: auto;
  padding-top: 40rpx;
  padding-bottom: 8rpx;
  box-sizing: border-box;
}

.status-row {
  display: flex;
  align-items: center;
  padding: 0 34rpx 8rpx;
  box-sizing: border-box;
  min-height: 0;
  height: auto;
}

.top-bar--horaire {
  position: relative;
  width: 100%;
  height: 92.3076923077rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 22rpx 0 20rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.back-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.back-circle {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #ececec;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #666;
  font-size: 20rpx;
}

.back-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #181818;
}

.logo {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 138rpx;
  height: 54rpx;
}

.avatar-bubble {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.avatar-bubble--horaire {
  margin-top: 0;
}

.avatar-wrap {
  width: 86rpx;
  height: 86rpx;
  border-radius: 43rpx;
  border: 4rpx solid #f2f2f2;
  background: #fff;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.12);
}

.avatar-wrap--bubble {
  border: 5rpx solid #ffffff;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.12);
}

.avatar-bubble-tail {
  width: 0;
  height: 0;
  border-left: 14rpx solid transparent;
  border-right: 14rpx solid transparent;
  border-top: 18rpx solid #ffffff;
  margin-top: -8rpx;
  filter: drop-shadow(0 4rpx 4rpx rgba(0, 0, 0, 0.06));
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.doctor-hero--horaire {
  /* Figma: 402x211 px, left -6, top 101 */
  width: 773.0769230769rpx;
  height: 345.7692307692rpx;
  margin-left: -11.5384615385rpx;
  margin-top: 0;
  flex-shrink: 0;
  background: #c1e2cb;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 12rpx 20rpx 16rpx;
  box-sizing: border-box;
}

.doctor-image {
  width: 248rpx;
  height: 252rpx;
  flex-shrink: 0;
}

/* Descendre un peu la photo pour l’aligner avec la bande menthe / le texte */
.doctor-hero--horaire .doctor-image {
  transform: translateY(18rpx);
}

.doctor-copy {
  flex: 1;
  min-width: 0;
  padding-bottom: 56rpx;
  box-sizing: border-box;
  display: flex;
  align-items: flex-end;
}

.hero-instruction {
  display: block;
  box-sizing: border-box;
  max-width: 400rpx;
  font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
  font-weight: 700;
  font-size: 26rpx;
  line-height: 38rpx;
  letter-spacing: 1rpx;
  color: #000000;
  text-align: left;
}

/* Zone créneaux */
.slots-block {
  display: flex;
  align-items: stretch;
  box-sizing: border-box;
}

/* Figma : 402×316 px, left -6, #70B682 — barres 328×44, radius 30, interstice ≈ 22px (demi-hauteur / repère rouge) */
.slots-block--figma {
  width: 773.0769230769rpx;
  min-height: 607.6923076923rpx;
  margin-left: -11.5384615385rpx;
  margin-top: 0;
  flex-shrink: 0;
  background: #70b682;
  opacity: 1;
  padding: 7.6923076923rpx 30.7692307692rpx 7.6923076923rpx 19.2307692308rpx;
  align-items: center;
  box-sizing: border-box;
}

/* Barre latérale : même hauteur que le scroll-view (liste défilante) */
.slots-block--figma .timeline {
  width: 32rpx;
  margin-right: 12rpx;
  min-height: 0;
  height: 420rpx;
  position: relative;
}

.slots-block--figma .timeline-rail {
  position: absolute;
  left: 50%;
  top: 8rpx;
  bottom: 8rpx;
  width: 3rpx;
  margin-left: -1.5rpx;
  border-radius: 2rpx;
  background: rgba(255, 255, 255, 0.92);
}

.slots-block--figma .timeline-thumb {
  position: absolute;
  left: 50%;
  z-index: 1;
  width: 16rpx;
  height: 16rpx;
  margin-left: 0;
  margin-top: 0;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.18);
}

/*
 * Hauteur < contenu des pilules : défilement obligatoire (sinon pas de scroll / pastille figée).
 * ~420rpx ≈ 210px @375 — 5 créneaux + interstices dépassent toujours.
 */
.slots-block--figma .slots-scroll {
  flex: 1;
  min-width: 0;
  min-height: 0;
  height: 420rpx;
  box-sizing: border-box;
}

.timeline {
  width: 28rpx;
  flex-shrink: 0;
  margin-right: 14rpx;
  position: relative;
  align-self: stretch;
  min-height: 200rpx;
}

.timeline-rail {
  position: absolute;
  left: 50%;
  top: 12rpx;
  bottom: 12rpx;
  width: 4rpx;
  margin-left: -2rpx;
  border-radius: 2rpx;
  background: rgba(255, 255, 255, 0.88);
}

.slots-block--figma .slots-list {
  align-items: flex-start;
  justify-content: flex-start;
  /* Figma : même hauteur que la bande claire / repère rouge entre barres (≈ 22px) */
  gap: 42.3280420481rpx;
  margin-left: 13.4615384615rpx;
  box-sizing: border-box;
}

.slots-list {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

/* Pilules Figma : 328×44.02 px, radius 30, left barre 39px depuis le bord zone verte */
.slots-block--figma .slot-pill {
  width: 631.5384615385rpx;
  max-width: 100%;
  height: 84.6566666667rpx;
  border-radius: 57.6923076923rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.slots-block--figma .slot-label {
  font-size: 28rpx;
}

.slot-pill {
  height: 64rpx;
  border-radius: 32rpx;
  background: #e8e8e8;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.slot-pill--selected {
  background: #1f5d40;
}

.slot-label {
  color: #1a1a1a;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.slot-label--selected {
  color: #ffffff;
}

/* Plus d’espace sous les créneaux avant Suivant (comme capture 2) */
.cta-area--horaire {
  flex-shrink: 0;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding: 48rpx 40rpx 16rpx;
  box-sizing: border-box;
}

/* Même bouton que medecin-domicile Figma */
.cta-btn {
  width: 607.6923076923rpx;
  max-width: 100%;
  margin-top: 16rpx;
  height: 111.5384615385rpx;
  box-sizing: border-box;
  background: #70b682;
  border-radius: 76.9230769231rpx;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 1;
}

.bottom-nav.bottom-nav--in-card {
  flex-shrink: 0;
  width: 100%;
  max-width: none;
  margin: auto 0 0;
  border-radius: 0 0 57.6923076923rpx 57.6923076923rpx;
  align-self: stretch;
  border-top: none;
  box-shadow: none;
}
