.container {
  background-color: #d0d0d0;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0;
  display: flex;
  justify-content: stretch;
  align-items: stretch;
}

.shell {
  width: 100%;
  min-height: 100vh;
  background: #ffffff;
  border-radius: 30rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  padding-top: 8rpx; /* décale légèrement le header vers le bas */
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 22rpx;
  background: #fff;
}
.back-btn {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.back-icon-wrap {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #f0f0f0;
  display: flex;
  justify-content: center;
  align-items: center;
}
.icon-back { width: 16rpx; height: 16rpx; opacity: 0.7; }
.back-text { font-size: 24rpx; color: #4a4a4a; font-weight: 600; }
.logo { width: 160rpx; height: 56rpx; }
.profile-container {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
  padding: 2px;
  box-sizing: border-box;
}
.profile-img {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: 2rpx solid #dcdcdc;
}

.banner-area {
  margin: 0;
}

.banner-top-bar {
  background-color: #b8d8c1;
  height: 52rpx;
  width: 100%;
}
.banner-section {
  position: relative;
  height: 292rpx;
  overflow: hidden;
}
.banner-img { width: 100%; height: 100%; }
.banner-content {
  position: absolute;
  bottom: 18rpx;
  left: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.banner-title {
  color: white;
  font-weight: 700;
  font-size: 30rpx;
  white-space: nowrap;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.35);
  margin-bottom: 14rpx;
}
.btn-acceder {
  background: #fff;
  color: #222;
  font-size: 21rpx;
  font-weight: 700;
  border-radius: 30rpx;
  width: 128rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  margin: 0;
}
.banner-nav-bar {
  background-color: #b8d8c1;
  height: 68rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 96rpx;
}
.nav-arrow-wrapper {
  background: #d9dfdb;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
}
.nav-arrow-icon {
  width: 14rpx;
  height: 14rpx;
  opacity: 0.55;
}

.section-title {
  text-align: center;
  margin: 24rpx 0 20rpx;
  font-size: 36rpx;
  line-height: 1;
  letter-spacing: 2rpx;
}
.thin {
  font-family: "The Cottage", "Brush Script MT", cursive;
  font-weight: 400;
  color: #123a53;
  margin-right: 6rpx;
}
.bold {
  font-family: "Neue Montreal", "Arial", sans-serif;
  font-weight: 700;
  font-size: 36rpx;
  line-height: 1;
  letter-spacing: 2rpx;
  text-align: center;
  text-transform: uppercase;
  color: #1c7a61;
}

.main-content-wrapper {
  display: flex;
  position: relative;
  padding: 0 20rpx;
  box-sizing: border-box;
  flex: 1;
  justify-content: center;
  align-items: flex-start;
  gap: 18rpx;
}
.services-grid {
  /* 2 colonnes: 232 + 232 + gap(28) = 492 */
  width: 492rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  align-content: flex-start;
  margin: 0 auto;
  /* Espacement identique vertical/horizontal */
  row-gap: 28rpx;
  column-gap: 28rpx;
}
.service-card {
  /* Figma: 116x149px, radius 9px (converti en rpx ~ x2) */
  width: 232rpx;
  height: 298rpx;
  margin-bottom: 0;
  border-radius: 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.2;
  padding: 12rpx 10rpx;
  box-sizing: border-box;
}
.service-card image {
  width: 150rpx;
  height: 150rpx;
  margin-bottom: 12rpx;
  display: block;
  margin-left: auto;
  margin-right: auto;
}

.color-1 { background-color: #7cbf8f; color: #fff; }
.color-2 { background-color: #7abf8a; color: #fff; }
.color-3 { background-color: #75bc86; color: #fff; }
.color-4 { background-color: #c9ddd2; color: #2f8a50; }
.color-5 { background-color: #a6dbc4; color: #fff; }
.white-text { color: #2f8a50; }

.side-scrollbar {
  width: 34rpx;
  margin-left: 0;
  margin-top: 10rpx;
  height: 350rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.scroll-track {
  width: 24rpx;
  background: #e6e6e6;
  border-radius: 20rpx;
  flex: 1;
  margin: 10rpx 0;
  position: relative;
  padding: 8rpx 0;
  box-sizing: border-box;
}
.scroll-handle {
  width: 100%;
  height: 66rpx;
  background: #3c7d58;
  border-radius: 20rpx;
  position: absolute;
  top: 0;
}
.scroll-arrow-up, .scroll-arrow-down {
  width: 32rpx;
  height: 32rpx;
  background: #dfe2e1;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
}
.scroll-arrow-icon {
  width: 12rpx;
  height: 12rpx;
  opacity: 0.5;
}
.scroll-arrow-up { transform: rotate(90deg); }
.scroll-arrow-down { transform: rotate(-90deg); }

.tab-bar {
  height: 132rpx;
  background: #e9e9e9;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1rpx solid #e5e5e5;
  margin-top: auto;
  padding: 0 70rpx;
  box-sizing: border-box;
}
.tab-icon { width: 24px; height: 24px; display: block; }

/* Tailles spécifiques par icône (approx. valeurs Figma) */
.tab-icon-home,
.tab-icon-msg,
.tab-icon-mic,
.tab-icon-cal,
.tab-icon-ambu {
  width: 24px;
  height: 24px;
}
.mic-container {
  background: #efefef;
  width: 112rpx;
  height: 112rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 50%;
  margin-top: -38rpx;
}
.mic-icon { width: 24px; height: 24px; }

.tab-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
}
.badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  background: #ffcc00;
  color: #000;
  font-size: 18rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
}