page {
  height: 100%;
  background: #1d1f23;
}

.page-recap {
  height: 100%;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 16rpx 0 calc(20rpx + env(safe-area-inset-bottom));
  background: #1d1f23;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow-x: hidden;
}

.mobile-card {
  margin: 0 auto;
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  background: #ffffff;
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.22);
}

.mobile-card--figma {
  width: 750rpx;
  max-width: 100%;
  box-sizing: border-box;
  border-radius: 57.6923076923rpx;
  min-height: 1619.2307692308rpx;
  overflow-x: hidden;
  position: relative;
}

.recap-header-wrap {
  flex-shrink: 0;
  background: #ffffff;
  padding-top: 36rpx;
  padding-bottom: 8rpx;
  box-sizing: border-box;
}

.status-row {
  display: flex;
  align-items: center;
  padding: 0 34rpx 8rpx;
  box-sizing: border-box;
  min-height: 0;
  height: auto;
}

.top-bar--recap {
  position: relative;
  width: 100%;
  height: 92.3076923077rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 22rpx 0 20rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.back-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.back-circle {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #ececec;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #666;
  font-size: 20rpx;
}

.back-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #181818;
}

.logo {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 138rpx;
  height: 54rpx;
}

.avatar-bubble {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.avatar-wrap {
  width: 86rpx;
  height: 86rpx;
  border-radius: 43rpx;
  border: 4rpx solid #f2f2f2;
  background: #fff;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.12);
}

.avatar-wrap--bubble {
  border: 5rpx solid #ffffff;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.12);
}

.avatar-bubble-tail {
  width: 0;
  height: 0;
  border-left: 14rpx solid transparent;
  border-right: 14rpx solid transparent;
  border-top: 18rpx solid #ffffff;
  margin-top: -8rpx;
  filter: drop-shadow(0 4rpx 4rpx rgba(0, 0, 0, 0.06));
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.recap-green-zone {
  /* Figma: 402x417 px, top 101, left -6 */
  width: 773.0769230769rpx;
  height: 801.9230769231rpx;
  margin-left: -11.5384615385rpx;
  flex-shrink: 0;
  background: #c1e2cb;
  padding: 22rpx 40rpx 30rpx;
  box-sizing: border-box;
}

.recap-panel {
  /* Figma: width 309, height 371, top 125, left 38, radius 11 */
  width: 594.2307692308rpx;
  height: 713.4615384615rpx;
  margin-left: 52.3076923077rpx;
  margin-top: 46.1538461538rpx;
  background: #f3f9f5;
  border-radius: 21.1538461538rpx;
  padding: 46.1538461538rpx 42.3076923077rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.recap-title {
  display: block;
  font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
  font-weight: 700;
  font-size: 34rpx;
  color: #2f7b43;
  margin-bottom: 16rpx;
  text-decoration: underline;
  text-underline-offset: 5rpx;
}

.recap-item {
  margin-bottom: 14rpx;
}

.recap-item--last {
  margin-bottom: 0;
}

.recap-label {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #111111;
  margin-bottom: 4rpx;
}

.recap-value {
  display: block;
  font-size: 30rpx;
  color: #303030;
  line-height: 1.35;
}

.recap-value--link {
  color: #2f6fa8;
  text-decoration: underline;
}

.confirm-area--recap {
  flex-shrink: 0;
  margin-top: auto;
  background: transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  /* Espace bouton -> barre aligné au repère rouge */
  padding: 8rpx 40rpx 54rpx;
  box-sizing: border-box;
}

.confirm-btn {
  width: 607.6923076923rpx;
  max-width: 100%;
  height: 111.5384615385rpx;
  box-sizing: border-box;
  background: #70b682;
  border-radius: 76.9230769231rpx;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bottom-nav.bottom-nav--in-card {
  flex-shrink: 0;
  width: 100%;
  max-width: none;
  margin: 0;
  border-radius: 0 0 57.6923076923rpx 57.6923076923rpx;
  align-self: stretch;
  border-top: none;
  box-shadow: none;
}
