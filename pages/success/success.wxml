<view class="page">
  <device-status-bar fillStatusBar="{{true}}" />
  <!-- ===== HEADER ===== -->
  <view class="header">
    <image 
      class="logo"
      src="/assets/logo-tiqqa-header.png"
      mode="widthFix"
    />
  </view>

  <!-- ===== SUCCESS CARD ===== -->
  <view class="card">

    <!-- PHONE IMAGE -->
    <view class="image-container">
      <image 
        class="phone-image"
        src="/assets/phone.png"
        mode="aspectFit"
      />
    </view>

    <!-- SUCCESS MESSAGE -->
    <text class="success-title">Votre mot de passe a été créé avec succès</text>

    <!-- CONTINUE BUTTON -->
    <view class="button-container">
      <view class="btn-arrow" bindtap="goToHome">
        <text class="arrow-icon">→</text>
      </view>
    </view>

  </view>

</view>
