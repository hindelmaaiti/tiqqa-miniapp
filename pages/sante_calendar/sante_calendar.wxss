.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #ffffff;
  overflow: hidden;
}

/* Header Section */
.header-bg {
  width: 100%;
  padding-bottom: 40rpx;
  background-color: #B38F7F;
}

.header-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 100rpx 40rpx 20rpx;
  position: relative;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.08);
  border-radius: 50%;
}

.back-arrow {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
}

.logo {
  width: 160rpx;
  height: 50rpx;
}

.profile-slot {
  position: relative;
  width: 84rpx;
  height: 84rpx;
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.8);
}

.msg-bubble {
  position: absolute;
  top: 50%;
  right: -15rpx;
  width: 44rpx;
  height: 44rpx;
  background: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.1);
  transform: translateY(-50%);
}

.bubble-icon {
  width: 28rpx;
  height: 28rpx;
}

/* Content Card */
.content-card {
  flex: 1;
  background-color: #ffffff;
  border-radius: 60rpx 60rpx 0 0;
  margin-top: -60rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 -10rpx 30rpx rgba(0, 0, 0, 0.05);
}

.card-scroll {
  height: 100%;
  width: 100%;
}

.page-title-wrap {
  padding: 60rpx 40rpx 20rpx;
  text-align: center;
}

.page-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
  line-height: 1.4;
}

.hero-image-wrap {
  display: flex;
  justify-content: center;
  padding: 20rpx 0 40rpx;
}

.hero-image {
  width: 300rpx;
  height: 280rpx;
}

/* Calendar Widget */
.calendar-widget {
  margin: 0 40rpx 40rpx;
  padding: 30rpx;
  background: #ffffff;
  border: 1rpx solid #F0F0F0;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.03);
}

.calendar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.month-nav {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F5F5;
  border-radius: 12rpx;
}

.nav-arrow {
  font-size: 40rpx;
  color: #333;
  line-height: 1;
}

.month-display {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.month-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
}

.year-text {
  font-size: 28rpx;
  color: #999;
}

.weekdays {
  display: flex;
  margin-bottom: 20rpx;
}

.weekday {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #B0B0B0;
  font-weight: 500;
}

.days-grid {
  display: flex;
  flex-wrap: wrap;
}

.day-cell-wrap {
  width: 14.28%;
  display: flex;
  justify-content: center;
  margin-bottom: 12rpx;
}

.day-cell {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #F9F9F9;
  transition: all 0.2s;
}

.day-num {
  font-size: 26rpx;
  color: #333;
}

.day-cell.selected {
  background-color: #B38F7F;
}

.day-cell.selected .day-num {
  color: #fff;
  font-weight: bold;
}

.day-cell.disabled {
  opacity: 0.3;
}

.day-empty {
  width: 72rpx;
  height: 72rpx;
}

/* Action Footer */
.action-footer {
  padding: 40rpx;
  margin-bottom: 40rpx;
}

.btn-valider {
  width: 100% !important;
  height: 100rpx;
  background-color: #B38F7F;
  color: #ffffff;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 20rpx rgba(179, 143, 127, 0.2);
}

.bottom-spacer {
  height: 160rpx;
}