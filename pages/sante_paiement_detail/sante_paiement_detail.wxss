.container {
  background-color: #d0d0d0;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0;
}

.shell {
  width: 100%;
  min-height: 100vh;
  background: #f4f5f4;
  border-radius: 30rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  padding-top: 8rpx;
}

/* Header */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 22rpx;
  background: #fff;
}
.back-btn { display: flex; align-items: center; gap: 10rpx; }
.back-icon-wrap {
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: #f0f0f0; display: flex; justify-content: center; align-items: center;
}
.icon-back { width: 16rpx; height: 16rpx; opacity: 0.7; }
.back-text { font-size: 24rpx; color: #4a4a4a; font-weight: 600; }
.logo { width: 160rpx; height: 56rpx; }
.profile-container {
  width: 44px; height: 44px; border-radius: 50%; background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12); padding: 2px; box-sizing: border-box;
}
.profile-img { width: 40px; height: 40px; border-radius: 50%; border: 2rpx solid #dcdcdc; }

/* Banner */
.banner-top-bar { background-color: #b8d8c1; height: 22rpx; width: 100%; }
.banner-section { position: relative; height: 230rpx; overflow: hidden; }
.banner-img { width: 100%; height: 100%; }
.banner-content {
  position: absolute; bottom: 16rpx; left: 24rpx;
  display: flex; flex-direction: column; align-items: flex-start;
}
.banner-title {
  color: #fff; font-weight: 700; font-size: 22rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.35); margin-bottom: 8rpx;
}
.btn-acceder {
  background: #fff; color: #222; font-size: 16rpx; font-weight: 700;
  border-radius: 30rpx; width: 110rpx; height: 38rpx; line-height: 38rpx; text-align: center;
}
.banner-nav-bar {
  background-color: #b8d8c1; height: 54rpx; display: flex;
  justify-content: space-between; align-items: center; padding: 0 180rpx;
}
.nav-arrow-wrapper {
  background: #d9dfdb; width: 30rpx; height: 30rpx; border-radius: 50%;
  display: flex; justify-content: center; align-items: center;
}
.nav-arrow-icon { width: 12rpx; height: 12rpx; opacity: 1; filter: brightness(0); }

/* Payment specific */
.payment-wrapper {
  flex: 1;
  display: flex;
  justify-content: center;
  margin-top: 30rpx; /* ajustement pour le rapprocher de top: 387px relatif */
}

.payment-card {
  background: #ffffff; /* Fond blanc comme sur la capture */
  width: 630rpx;
  height: 700rpx;
  border-radius: 28rpx;
  padding: 40rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05); /* Ombre légère */
}

.payment-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2b2b2b;
  margin-bottom: 12rpx;
}

.divider {
  width: 100%;
  height: 2rpx;
  background: #3c3c3c;
  margin-bottom: 30rpx;
}

.method-box {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #3c3c3c;
  border-radius: 50rpx;
  padding: 16rpx 0;
  margin-bottom: 30rpx;
  background: #f3f8f5;
  gap: 16rpx;
}

.method-icon {
  width: 50rpx;
  height: 50rpx;
}

.method-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #3c3c3c;
}

.detail-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2f8550;
  margin-bottom: 16rpx;
}

.detail-row {
  margin-bottom: 14rpx;
  font-size: 24rpx;
}

.detail-row .label {
  font-weight: 700;
  color: #1a1a1a;
}

.detail-row .value {
  color: #4a4a4a;
}

.cgu-row {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  margin-bottom: 30rpx;
}

.checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #dcdcdc;
  background: #e6e6e6;
  border-radius: 4rpx;
  margin-right: 14rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.checkbox.checked {
  background: #2f8550;
  border-color: #2f8550;
}

.checkmark {
  width: 12rpx;
  height: 24rpx;
  border: solid white;
  border-width: 0 4rpx 4rpx 0;
  transform: rotate(45deg);
  margin-bottom: 6rpx;
}

.cgu-text {
  font-size: 24rpx;
  color: #3c3c3c;
}

.btn-confirm {
  width: 100% !important;
  background: #3c7d58 !important;
  color: white !important;
  font-weight: 800;
  font-size: 32rpx;
  border-radius: 16rpx !important;
  height: 90rpx !important;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin-top: 40rpx;
  text-transform: uppercase;
}

/* Modal */
.modal-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(255, 255, 255, 0.4);
  backdrop-filter: blur(8px); /* Effet flou sur le fond */
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.modal-content {
  background: #333333;
  width: 580rpx;
  border-radius: 46rpx;
  padding: 70rpx 40rpx 50rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.modal-text {
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 600;
  text-align: center;
  line-height: 1.5;
  margin-bottom: 60rpx;
}

.modal-close {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #e6e6e6;
  display: flex;
  justify-content: center;
  align-items: center;
}

.close-icon {
  font-size: 36rpx;
  color: #333;
  font-weight: 400;
}


