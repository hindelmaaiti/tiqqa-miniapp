.container {
  background-color: #d0d0d0;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0;
  display: flex;
  justify-content: stretch;
  align-items: stretch;
}

.shell {
  width: 100%;
  min-height: 100vh;
  background: #ffffff;
  border-radius: 30rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  padding-top: 8rpx;
}

/* Header identique à `pages/sante/sante` */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 76rpx;
  padding: 2rpx 22rpx 2rpx;
  margin-top: 8rpx;
  background: #fff;
}
.back-btn {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.back-icon-wrap {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #f0f0f0;
  display: flex;
  justify-content: center;
  align-items: center;
}
.icon-back {
  width: 16rpx;
  height: 16rpx;
  opacity: 0.7;
}
.back-text {
  font-size: 24rpx;
  color: #4a4a4a;
  font-weight: 600;
}
.logo {
  width: 160rpx;
  height: 56rpx;
}


.hero-title {
  background: #C1E2CB;
  padding: 30rpx 28rpx 12rpx;
  text-align: center;
  color: #1b2b24;
  font-size: 30rpx;
  font-weight: 700;
}

.map-main-area {
  background: #70B682;
  padding-bottom: 20rpx;
  padding-top: 10rpx;
}

.bottom-divider-band {
  background: #C1E2CB;
  height: 20rpx;
  width: 100%;
}

.location-box {
  width: 282px;
  height: 48px;
  margin: 18rpx auto 12rpx;
  background: #678E71;
  border-radius: 37px;
  border: 1px solid #678E71;
  padding: 0 40rpx;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}


.location-left {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}
.location-label {
  font-size: 20rpx;
  font-weight: 700;
  opacity: 0.95;
  line-height: 28rpx;
}
.location-input {
  flex: 1;
  min-width: 0;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 400;
  height: 28rpx;
  line-height: 28rpx;
}
.location-placeholder {
  color: rgba(255, 255, 255, 0.75);
}
.edit-icon {
  width: 30rpx;
  height: 30rpx;
  opacity: 0.85;
}

.map-container {
  margin: 10rpx 28rpx 0;
  border-radius: 16rpx;
  overflow: hidden;
  background: #ffffff;
  height: 320rpx;
}

.doctor-area {
  background: #ffffff;
  padding: 14rpx 0 8rpx;
  font-size: 0;
  line-height: 0;
}
.doctor {
  width: 260rpx;
  height: 220rpx;
  display: block;
  margin: 0 auto;
  vertical-align: bottom;
}

.actions {
  background: #ffffff;
  padding: 0 0 22rpx;
  margin-top: 6rpx;
}
.btn {
  width: 78%;
  margin: 0 auto 18rpx;
  height: 86rpx;
  border-radius: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-weight: 800;
  font-size: 28rpx;
  padding: 0;
}
.btn:last-child {
  margin-bottom: 0;
}
.next {
  background: #70b682;
  color: #ffffff;
}
.location {
  background: #4b5d54;
  color: #ffffff;
}


