.container {
  background-color: #d0d0d0;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0;
  display: flex;
  justify-content: stretch;
  align-items: stretch;
}

.shell {
  width: 100%;
  min-height: 100vh;
  background: #f2f4f3;
  border-radius: 30rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  padding-top: 8rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 84rpx;
  padding: 4rpx 22rpx 4rpx;
  margin-top: 6rpx;
  background: #ffffff;
}

.back-btn {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.back-icon-wrap {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #f0f0f0;
  display: flex;
  justify-content: center;
  align-items: center;
}

.icon-back {
  width: 16rpx;
  height: 16rpx;
  opacity: 0.7;
}

.back-text {
  font-size: 24rpx;
  color: #4a4a4a;
  font-weight: 600;
}

.logo {
  width: 160rpx;
  height: 56rpx;
}

.profile-container {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
  padding: 2px;
  box-sizing: border-box;
}

.profile-img {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: 2rpx solid #dcdcdc;
}

.content-area {
  background: #b8d8c1;
  padding: 34rpx 26rpx 26rpx;
}

.recap-card {
  background: #e4e9e5;
  border-radius: 20rpx;
  padding: 30rpx 38rpx;
}

.card-title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #257e4c;
  text-decoration: underline;
  margin-bottom: 24rpx;
}

.field {
  margin-bottom: 16rpx;
}

.label {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #111111;
  margin-bottom: 4rpx;
}

.value {
  display: block;
  font-size: 28rpx;
  color: #525252;
  line-height: 1.3;
}

.no-margin {
  margin-bottom: 0;
}

.doctor-wrap {
  padding-top: 8rpx;
  background: #f4f5f4;
  display: flex;
  justify-content: center;
}

.doctor-image {
  width: 270rpx;
  height: 250rpx;
}

.confirm-btn {
  width: 84%;
  margin: 12rpx auto 22rpx;
  height: 86rpx;
  border-radius: 43rpx;
  background: #70b682;
  color: #ffffff;
  font-size: 33rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}


