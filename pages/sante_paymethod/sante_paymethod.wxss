.container {
  background-color: #d0d0d0;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0;
  display: flex;
  justify-content: stretch;
  align-items: stretch;
}

.shell {
  width: 100%;
  min-height: 100vh;
  background: #f2f4f3;
  border-radius: 30rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  padding-top: 8rpx;
}

/* New Header Styles from Photo */
.horaire-header-wrap {
  flex-shrink: 0;
  background: #ffffff;
  min-height: 120rpx;
  height: auto;
  padding-top: 10rpx;
  padding-bottom: 8rpx;
  box-sizing: border-box;
  position: sticky;
  top: 0;
  z-index: 100;
}

.status-row {
  display: flex;
  align-items: center;
  padding: 0 34rpx 0rpx;
  box-sizing: border-box;
  min-height: 0;
  height: auto;
}

.top-bar--horaire {
  position: relative;
  width: 100%;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 40rpx 0 20rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.back-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.back-circle {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: #f2f2f2;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #333;
  font-size: 24rpx;
  font-weight: bold;
}

.back-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #000000;
}

.logo {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 160rpx;
  height: 60rpx;
}

.avatar-bubble {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  position: relative;
  z-index: 10;
}

.avatar-wrap {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  background: transparent;
}

.avatar-wrap--bubble {
  border: none;
  box-shadow: none;
  overflow: hidden;
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.content-area {
  background: #b8d8c1;
  padding: 34rpx 26rpx 26rpx;
}

.recap-card {
  background: #e4e9e5;
  border-radius: 20rpx;
  padding: 30rpx 38rpx;
}

.card-title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #257e4c;
  text-decoration: underline;
  margin-bottom: 24rpx;
}

.field {
  margin-bottom: 16rpx;
}

.label {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #111111;
  margin-bottom: 4rpx;
}

.value {
  display: block;
  font-size: 28rpx;
  color: #525252;
  line-height: 1.3;
}

.no-margin {
  margin-bottom: 0;
}

.doctor-wrap {
  padding-top: 8rpx;
  background: #f4f5f4;
  display: flex;
  justify-content: center;
}

.doctor-image {
  width: 270rpx;
  height: 250rpx;
}

.confirm-btn {
  width: 84%;
  margin: 12rpx auto 22rpx;
  height: 86rpx;
  border-radius: 43rpx;
  background: #70b682;
  color: #ffffff;
  font-size: 33rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}


